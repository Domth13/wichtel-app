# Lokale Entwicklung: Kopie als .env anlegen.
# Für Streamlit Cloud diese Werte unter "Settings -> Secrets" eintragen.

APP_URL = "http://localhost:8501"
USE_MONGODB = "false"
# MONGODB_URI = "mongodb+srv://user:pass@cluster.mongodb.net/"
# DATABASE_NAME = "wichtel_app"

# Erster Admin (nur nötig, wenn noch kein Admin in der Datenbank existiert)
ADMIN_EMAIL = "admin@example.com"
ADMIN_NAME = "Admin"
ADMIN_PASSWORD = "bitte-langes-passwort-setzen"

# Optionaler E-Mail-Versand (Gmail-App-Passwort)
SENDER_EMAIL = "deine.email@gmail.com"
SENDER_PASSWORD = "dein_app_passwort"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
